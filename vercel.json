{
  "rewrites": [
    { "source": "/api/reserve-ticket", "destination": "/api/ticket" },
    { "source": "/api/submit-receipt", "destination": "/api/ticket" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}