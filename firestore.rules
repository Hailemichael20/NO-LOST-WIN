rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Data model:
    // users/{uid}: private profile (name, phone); wallet and password-reset fields
    //   are server-managed.
    // entries/{id}: canonical category, ticket number, and review state.
    // entryPrivate/{id}: admin-only contact details and receipt image.
    // ticketReservations/{tier-number}: private ticket holder details and six-hour expiry.
    // ticketBoard/{tier-number}: authenticated reservation details and ticket status.
    // settings/{id}: prize/payment settings and bilingual published announcement.
    // drawSchedule/{tier}: admin-managed draw timestamp.
    // drawEvents/{id}: immutable server-selected and authenticated-user-readable result.
    // drawLocks/{tier}: server-managed transaction lock.

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.get('admin', false) == true;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isValidUser(data) {
      return data.keys().hasOnly([
          'fullName', 'phone', 'createdAt', 'winBirrBalance', 'walletUpdatedAt',
          'mustChangePassword', 'passwordChangeRequiredAt',
          'passwordChangeRequiredPasswordUpdatedAt'
        ])
        && data.fullName is string
        && data.fullName.size() > 0
        && data.fullName.size() <= 100
        && data.phone is string
        && data.phone.size() >= 7
        && data.phone.size() <= 32
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('winBirrBalance' in data) || data.winBirrBalance is number)
        && (!('walletUpdatedAt' in data) || data.walletUpdatedAt is timestamp)
        && (!('mustChangePassword' in data) || data.mustChangePassword is bool)
        && (!('passwordChangeRequiredAt' in data) || data.passwordChangeRequiredAt is timestamp)
        && (!('passwordChangeRequiredPasswordUpdatedAt' in data)
          || (data.passwordChangeRequiredPasswordUpdatedAt is string
            && data.passwordChangeRequiredPasswordUpdatedAt.size() <= 40));
    }

    function isValidReservation(data) {
      return data.keys().hasOnly([
          'ownerUid', 'tier', 'number', 'fullName', 'phone', 'status',
          'reservedAt', 'expiresAt', 'entryId'
        ])
        && data.keys().hasAll([
          'ownerUid', 'tier', 'number', 'fullName', 'phone', 'status',
          'reservedAt', 'expiresAt'
        ])
        && data.ownerUid is string
        && data.tier in ['50', '100', '200', '500']
        && data.number is string
        && data.number.matches('^[0-9]{3}$')
        && data.number != '000'
        && data.fullName is string
        && data.fullName.size() > 0
        && data.fullName.size() <= 100
        && data.phone is string
        && data.phone.size() >= 7
        && data.phone.size() <= 32
        && data.status in ['reserved', 'pending', 'approved', 'rejected']
        && data.reservedAt is timestamp
        && (!('entryId' in data) || (data.entryId is string && data.entryId.size() <= 128));
    }

    function isValidBoard(data) {
      return data.keys().hasOnly([
          'ownerUid', 'tier', 'number', 'fullName', 'phoneLast4',
          'status', 'reservedAt', 'expiresAt'
        ])
        && data.keys().hasAll([
          'ownerUid', 'tier', 'number', 'fullName', 'phoneLast4',
          'status', 'reservedAt', 'expiresAt'
        ])
        && data.ownerUid is string
        && data.tier in ['50', '100', '200', '500']
        && data.number is string
        && data.number.matches('^[0-9]{3}$')
        && data.number != '000'
        && data.fullName is string
        && data.fullName.size() > 0
        && data.fullName.size() <= 100
        && data.phoneLast4 is string
        && data.phoneLast4.size() == 4
        && data.status in ['reserved', 'pending', 'approved', 'rejected']
        && data.reservedAt is timestamp;
    }

    function reservationPath(reservationId) {
      return /databases/$(database)/documents/ticketReservations/$(reservationId);
    }

    function isValidEntry(data) {
      return data.keys().hasOnly([
          'entryId', 'tier', 'number', 'ticketReservationId', 'phoneLast4', 'status', 'createdAt'
        ])
        && data.keys().hasAll(['tier', 'status', 'createdAt'])
        && data.tier in [50, 100, 200, 500]
        && data.status in ['pending', 'approved', 'rejected']
        && data.createdAt is timestamp
        && (!('entryId' in data) || data.entryId is string)
        && (!('number' in data)
          || (data.number is string && data.number.matches('^[0-9]{3}$') && data.number != '000'))
        && (!('ticketReservationId' in data) || data.ticketReservationId is string)
        && (!('phoneLast4' in data) || (data.phoneLast4 is string && data.phoneLast4.matches('^[0-9]{4}$')));
    }

    function isValidSetting(settingId, data) {
      return (settingId == 'payment'
          && data.keys().hasOnly(['telebirr', 'cbe', 'updatedAt'])
          && data.telebirr is string
          && data.telebirr.size() <= 40
          && data.cbe is string
          && data.cbe.size() <= 60
          && data.updatedAt is timestamp)
        || (settingId == 'prizes'
          && data.keys().hasOnly(['prizeAmounts', 'updatedAt'])
          && data.prizeAmounts is map
          && data.updatedAt is timestamp)
        || (settingId == 'announcement'
          && data.keys().hasOnly([
            'titleEn', 'bodyEn', 'titleAm', 'bodyAm', 'published', 'updatedAt'
          ])
          && data.titleEn is string
          && data.titleEn.size() <= 120
          && data.bodyEn is string
          && data.bodyEn.size() <= 4000
          && data.titleAm is string
          && data.titleAm.size() <= 120
          && data.bodyAm is string
          && data.bodyAm.size() <= 4000
          && data.published is bool
          && data.updatedAt is timestamp)
        || (settingId == 'contact'
          && data.keys().hasOnly(['phone', 'telegram', 'updatedAt'])
          && data.phone is string
          && data.phone.size() <= 40
          && data.telegram is string
          && data.telegram.size() <= 80
          && data.updatedAt is timestamp);
    }

    function isValidDrawSchedule(tier, data) {
      return tier in ['50', '100', '200', '500']
        && data.keys().hasOnly(['tier', 'drawAt', 'updatedAt'])
        && data.tier == tier
        && data.drawAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isOwner(userId)
        && isValidUser(request.resource.data)
        && request.resource.data.keys().hasOnly(['fullName', 'phone', 'createdAt'])
        && request.resource.data.createdAt is timestamp;
      allow update: if isOwner(userId)
        && isValidUser(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fullName', 'phone']);
      allow delete: if isAdmin();
    }

    match /passwordResetRequests/{requestId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /logs/{logId=**} {
      allow read, write: if false;
    }

    match /adminLogs/{logId=**} {
      allow read, write: if false;
    }

    match /passwordResetLogs/{logId=**} {
      allow read, write: if false;
    }

    match /drawSchedule/{tier} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && isValidDrawSchedule(tier, request.resource.data);
      allow delete: if isAdmin();
    }

    match /drawEvents/{eventId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /drawLocks/{tier} {
      allow read, write: if false;
    }

    match /entries/{entryId} {
      allow create: if false;
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.status == 'approved');
      allow update: if isAdmin()
        && isValidEntry(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'number', 'phoneLast4'])
        && resource.data.status in ['pending', 'rejected']
        && request.resource.data.status in ['approved', 'rejected'];
      allow delete: if isAdmin() && resource.data.status != 'approved';
    }

    match /entryPrivate/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
      allow delete: if isAdmin();
    }

    match /ticketReservations/{reservationId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.ownerUid == request.auth.uid);
      allow create: if false;
      allow update: if isValidReservation(request.resource.data)
        && isAdmin()
        && resource.data.status in ['reserved', 'pending', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['approved', 'rejected'];
      allow delete: if isAdmin() && resource.data.status != 'approved';
    }

    match /ticketBoard/{reservationId} {
      allow read: if isAdmin();
      allow read: if isAuthenticated() && resource.data.status == 'approved';
      allow read: if isAuthenticated() && resource.data.expiresAt > request.time;
      allow create: if false;
      allow update: if isValidBoard(request.resource.data)
        && isAdmin()
        && resource.data.status in ['reserved', 'pending', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['approved', 'rejected'];
      allow delete: if isAdmin() && resource.data.status != 'approved';
    }

    match /walletTransactions/{transactionId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /settings/{settingId} {
      allow read: if settingId == 'contact'
        || (isAuthenticated() && settingId in ['prizes', 'payment', 'announcement']);
      allow create, update: if isAdmin() && isValidSetting(settingId, request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
